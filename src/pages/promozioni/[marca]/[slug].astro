---
import Base from '~/layouts/Base.astro';
import PromoBox from '~/components/compare/PromoBox.astro';
import ResultCard from '~/components/decode/ResultCard';
import Scena from '~/components/scene/Scena';
import { dataBreve } from '~/lib/date';
import { euro } from '~/lib/formato';
import { tutteLePromo } from '~/lib/promo';
import { paginaNonTrovata } from '~/lib/nonTrovata';

// Resa a ogni richiesta, come l'elenco: l'avviso «scaduta il…» compare il giorno dopo la scadenza
// senza ricostruire il sito, e non c'è nell'HTML finché la promozione è in vigore.
export const prerender = false;

const d = tutteLePromo(new Date()).find((x) => x.slugMarca === Astro.params.marca && x.slug === Astro.params.slug);
if (!d) return paginaNonTrovata(Astro.locals.runtime?.env, Astro.url);
Astro.response.headers.set('cache-control', 'public, max-age=900');
const p = d.promo;
const a = d.analisi;
const titolo = [p.marca, p.modello, p.versione].filter(Boolean).join(' ');
const { fonte: _fonte, ...base } = a.preventivo;
---
<Base
  title={`${titolo} a ${euro(p.rata, 0)} al mese: quanto paghi davvero | Rata Vera`}
  description={`Promozione ${titolo} con i conti fatti: totale pagato ${euro(a.totali.totalePagatoTenendo)}, costo del credito, TAEG e fine contratto. Fonte ufficiale, valida fino al ${dataBreve(p.validoAl)}.`}
>
  <section class="contenitore pt-8 sm:pt-14 grid gap-4">
    <p class="text-sm"><a class="link" href="/promozioni">Promozioni</a> / {p.marca}</p>
    <h1 class="titolo-pagina max-w-[20ch]">{titolo}: i conti della promozione</h1>
  </section>

  <!-- La scena è il primo schermo del risultato; la tabella completa resta sotto (specifica v2, §2). -->
  <section class="contenitore pt-8" aria-label="La scena della promozione">
    {/* client:only: il server non rende la scena. Il segnaposto è più alto dello schermo, così quando la scena arriva
        nulla di visibile si sposta (CLS 0,46-0,57 prima della revisione del 31/10). */}
    <Scena client:only="preact" preventivo={base} vfg={p.valoreFuturoGarantito ?? null}>
      <div slot="fallback" class="pannello-scena min-h-[130svh]" aria-busy="true" aria-label="Caricamento della scena"></div>
    </Scena>
  </section>

  <!-- Il riquadro unico della promozione (fonte e scadenza), poi i conti: lo scontrino si stampa quando arriva in vista.
       Le tre strade stanno nell'atto 3 della scena, una volta sola (revisione del 31/10). -->
  <section class="contenitore sezione grid gap-10 lg:grid-cols-[minmax(0,36rem)_minmax(0,1fr)] lg:items-end lg:gap-14" aria-labelledby="riquadro-titolo">
    <div class="grid gap-3">
      <h2 id="riquadro-titolo" class="titolo-scheda">La promozione come la pubblica la casa</h2>
      <PromoBox decodificata={d} composizione={false} />
    </div>
    <div class="grid content-end gap-4">
      <p class="max-w-[28em] text-tenue">Sotto, i conti sugli stessi numeri: quanto paghi in tutto, da dove viene il totale e cosa controllare.</p>
      <p><a class="btn btn-primario" href="/#decodifica">Leggi il tuo preventivo</a></p>
    </div>
  </section>

  <section class="contenitore pb-8" aria-label="I conti della promozione">
    <ResultCard analisi={a} azioni={null} />
  </section>
</Base>
