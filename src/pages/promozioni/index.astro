---
import Base from '~/layouts/Base.astro';
import PromoBox from '~/components/compare/PromoBox.astro';
import TitoloRighe from '~/components/ui/TitoloRighe.astro';
import { tutteLePromo } from '~/lib/promo';
import { VUOTO_SENZA_PROMO } from '~/lib/client/filtriPromo';

// Reso a ogni richiesta: le promo scadute spariscono dall'HTML il giorno dopo la scadenza, senza ricostruire (§1.5).
export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=900');
const tutte = tutteLePromo(new Date());
const inVigore = tutte.filter((d) => !d.scaduta);
const marche = [...new Set(inVigore.map((d) => d.promo.marca))].sort();
---
<Base
  title="Promozioni auto ufficiali con i conti fatti: totale e costo del credito | Rata Vera"
  description="Le offerte ufficiali delle case auto nel riquadro unico: rata, anticipo, maxi rata, TAN, TAEG, totale pagato e costo del credito, con fonte e scadenza."
>
  <section class="contenitore pt-8 pb-10 sm:pt-14 grid gap-5">
    <p class="etichetta">Promozioni ufficiali in vigore · {inVigore.length === 1 ? '1 offerta' : `${inVigore.length} offerte`}</p>
    <TitoloRighe righe={['Promozioni ufficiali,', 'con i conti fatti.']} accento={1} classe="titolo-pagina max-w-[18ch]" />
    <p class="text-lg max-w-prose text-tenue">
      Ogni offerta è nello stesso riquadro: rata, anticipo, maxi rata, TAN, TAEG, prezzo, validità e fonte. Accanto c'è quello che paghi in tutto e il costo del credito.
    </p>
    <p class="text-sm max-w-prose">
      Ordine unico: costo del credito in percentuale del prezzo, dal più basso. Nessuna posizione a pagamento. <a class="link" href="/criteri">Come scegliamo e ordiniamo</a>.
    </p>
  </section>

  <section class="contenitore grid gap-8" aria-label="Elenco delle promozioni">
    <form class="grid gap-3 sm:grid-cols-4 border-y border-riga py-4" data-filtri aria-label="Filtri">
      <label class="grid gap-1 text-sm"><span class="font-medium">Marca</span>
        <select class="campo" name="marca"><option value="">Tutte</option>{marche.map((m) => <option value={m}>{m}</option>)}</select>
      </label>
      <label class="grid gap-1 text-sm"><span class="font-medium">Anticipo fino a</span>
        <input class="campo" name="anticipo" inputmode="numeric" placeholder="€" />
      </label>
      <label class="grid gap-1 text-sm"><span class="font-medium">Rata fino a</span>
        <input class="campo" name="rata" inputmode="numeric" placeholder="€ al mese" />
      </label>
      <label class="grid gap-1 text-sm"><span class="font-medium">Maxi rata finale</span>
        <select class="campo" name="maxi"><option value="">Indifferente</option><option value="1">Sì</option><option value="0">No</option></select>
      </label>
    </form>

    <div class="grid gap-10 lg:grid-cols-2" data-elenco>
      {inVigore.map((d) => <PromoBox decodificata={d} link />)}
    </div>
    <p class="text-tenue empty:hidden" data-vuoto aria-live="polite">{inVigore.length === 0 ? VUOTO_SENZA_PROMO : ''}</p>
    <p class="text-sm text-tenue max-w-prose">
      Le offerte scadute escono dall'elenco in automatico. Il dataset cresce ogni settimana: ogni riquadro riporta la data in cui abbiamo controllato la fonte.
    </p>
  </section>
</Base>

<script>
  import { applicaFiltri } from '~/lib/client/filtriPromo';
  const modulo = document.querySelector<HTMLFormElement>('[data-filtri]');
  const aggiorna = () => modulo && applicaFiltri(document.querySelectorAll<HTMLElement>('[data-promo]'), document.querySelector<HTMLElement>('[data-vuoto]'), new FormData(modulo));
  modulo?.addEventListener('input', aggiorna);
  aggiorna();
</script>
