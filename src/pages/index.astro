---
import Base from '~/layouts/Base.astro';
import DecodeForm from '~/components/decode/DecodeForm';
import Fiducia from '~/components/ui/Fiducia.astro';
import TitoloRighe from '~/components/ui/TitoloRighe.astro';
import SceltaDocumento from '~/components/home/SceltaDocumento.astro';
import AnteprimaScena from '~/components/home/AnteprimaScena.astro';
import { TURNSTILE_SITE_KEY_TEST } from '~/lib/turnstile';
import { etichettaEsempio } from '~/lib/esempio';

export const prerender = false;
const siteKey = Astro.locals.runtime?.env?.PUBLIC_TURNSTILE_SITE_KEY || TURNSTILE_SITE_KEY_TEST;
---
<Base
  title="Rata Vera: quanto paghi davvero, prima di firmare"
  description="Hai in mano un preventivo di finanziamento auto? Fotografalo o scrivi i numeri: in trenta secondi vedi il totale che paghi, il costo del credito e cosa succede con la maxi rata finale."
>
  <section class="contenitore grid gap-10 pt-4 pb-12 sm:pt-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14" aria-labelledby="home-titolo">
    <div class="grid content-start gap-7">
      <p class="etichetta">Quanto paghi davvero, prima di firmare</p>
      <TitoloRighe id="home-titolo" righe={['Che documento', 'hai in mano?']} accento={1} classe="titolo-display titolo-home" />
      <SceltaDocumento />
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/?esempio=1#risultato" role="button" class="btn btn-secondario" data-prova-esempio>Prova con un preventivo d'esempio</a>
        <span class="nota text-tenue">Peugeot 208 Style · {etichettaEsempio()}</span>
      </div>
      <Fiducia variante="riquadro" />
    </div>
    <div class="lg:sticky lg:top-6 lg:self-start">
      <AnteprimaScena />
    </div>
  </section>

  <section id="decodifica" class="contenitore scroll-mt-6 grid gap-6" aria-labelledby="decodifica-titolo">
    <div class="grid gap-2 border-t-2 border-inchiostro pt-6">
      <p class="numeri text-sm">01</p>
      <h2 id="decodifica-titolo" class="titolo-sezione">Leggi il preventivo di finanziamento</h2>
      <p class="max-w-[58ch] text-tenue">Fotografa il foglio della concessionaria o scrivi i numeri. Vedi il totale, il costo del credito e cosa succede alla fine con la maxi rata.</p>
    </div>
    <DecodeForm client:load siteKey={siteKey} />
  </section>

  <section class="contenitore sezione grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16" aria-labelledby="come-titolo">
    <div class="grid content-start gap-6">
      <h2 id="come-titolo" class="titolo-sezione">Come facciamo i conti</h2>
      <!-- Le quattro barre: dove vanno gli euro del totale. Immagine ferma, decorativa: i numeri veri stanno nella scena. -->
      <picture class="block overflow-hidden rounded-[var(--raggio-pannello)] border border-inchiostro bg-inchiostro">
        <source type="image/avif" srcset="/img/scena-poster-800.avif 800w, /img/scena-poster-1200.avif 1200w" sizes="(min-width: 1024px) 30rem, 100vw" />
        <img src="/img/scena-poster-800.webp" srcset="/img/scena-poster-800.webp 800w, /img/scena-poster-1200.webp 1200w" sizes="(min-width: 1024px) 30rem, 100vw"
          width="1200" height="751" alt="" loading="lazy" decoding="async" class="block aspect-[10/3] h-auto w-full object-cover object-top" />
      </picture>
      <p class="nota max-w-[40ch] text-tenue">I calcoli girano nel tuo browser. Le formule, una per una, sono nella <a class="link" href="/metodologia">metodologia</a>.</p>
    </div>
    <ol class="grid content-start gap-10 lg:pt-2">
      <li class="si-accende grid grid-cols-[3.5rem_1fr] gap-4 border-t border-inchiostro pt-5 sm:grid-cols-[5rem_1fr]">
        <span class="numero-scena text-segnale-scuro">01</span>
        <div class="grid gap-2"><h3 class="titolo-scheda">Sommiamo tutto quello che esce dal tuo conto</h3><p class="max-w-[52ch] text-tenue">Anticipo, rate, maxi rata, spese. Il totale è il numero che il cartello con la rata non dice.</p></div>
      </li>
      <li class="si-accende grid grid-cols-[3.5rem_1fr] gap-4 border-t border-inchiostro pt-5 sm:grid-cols-[5rem_1fr]">
        <span class="numero-scena text-segnale-scuro">02</span>
        <div class="grid gap-2"><h3 class="titolo-scheda">Lo confrontiamo con il prezzo</h3><p class="max-w-[52ch] text-tenue">La differenza è il costo del credito. Ricostruiamo anche il TAEG dai numeri visibili e ti diciamo se torna.</p></div>
      </li>
      <li class="si-accende grid grid-cols-[3.5rem_1fr] gap-4 border-t border-inchiostro pt-5 sm:grid-cols-[5rem_1fr]">
        <span class="numero-scena text-segnale-scuro">03</span>
        <div class="grid gap-2"><h3 class="titolo-scheda">Ti mostriamo la fine del contratto</h3><p class="max-w-[52ch] text-tenue">Tenere l’auto pagando la maxi rata, restituirla o cambiarla, e il valore stimato dell’auto contro il debito, mese per mese.</p></div>
      </li>
    </ol>
  </section>
</Base>

<script>
  import { collegaPulsanteEsempio } from '~/lib/client/esempio';
  collegaPulsanteEsempio(document);
</script>
