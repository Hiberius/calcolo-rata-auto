---
import Base from '~/layouts/Base.astro';
import DecodeForm from '~/components/decode/DecodeForm';
import TitoloRighe from '~/components/ui/TitoloRighe.astro';
import AnteprimaScena from '~/components/home/AnteprimaScena.astro';
import { chiaveAntiRobot } from '~/lib/turnstile';

export const prerender = false;
const env = Astro.locals.runtime?.env;
const siteKey = chiaveAntiRobot(env, Astro.url.href);
---
<Base
  title="Rata Vera: quanto paghi davvero per l’auto a rate"
  description="Fai una foto al preventivo di finanziamento del concessionario: vedi il totale che esce dalla tua tasca, quanto ti costa il credito e cosa succede alla fine del contratto. Gratis, senza registrazione."
>
  <!-- Primo schermo (specifica v2, §1): la promessa prima del documento, due azioni. Nessun nome di persona in prima pagina (richiesta di Christian del 31/10 notte). -->
  <section class="contenitore grid gap-10 pt-3 pb-14 sm:pt-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14" aria-labelledby="home-titolo">
    <div class="hero-colonna grid grid-cols-[minmax(0,1fr)] content-start gap-5 sm:gap-6">
      <p class="etichetta">Gratis · senza registrazione · la foto non viene salvata</p>
      <TitoloRighe id="home-titolo" righe={['Quanto paghi davvero', 'per l’auto a rate?']} parola="davvero" classe="titolo-display titolo-home" />
      <p class="max-w-[30em] text-[1.0625rem] leading-relaxed sm:text-lg">Fai una foto al preventivo del concessionario. Ti diciamo il totale che esce dalla tua tasca, quanto ti costa il credito e cosa succede alla fine del contratto.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-1">
        <a href="#decodifica" class="btn btn-primario" data-fotografa>Fotografa il preventivo</a>
        <a href="/?esempio=1#risultato" class="link-azione" data-prova-esempio>Guarda l’esempio: Peugeot 208 a 99&nbsp;€ al mese <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="lg:sticky lg:top-6 lg:self-start">
      <AnteprimaScena />
    </div>
  </section>

  <section id="decodifica" class="contenitore scroll-mt-6 grid gap-6" aria-labelledby="decodifica-titolo">
    <div class="grid gap-2 border-t-2 border-inchiostro pt-6">
      <p class="numeri text-sm">01</p>
      <h2 id="decodifica-titolo" class="titolo-sezione">Leggi il preventivo di finanziamento</h2>
      <p class="max-w-[31em] text-tenue">Fotografa il foglio della concessionaria o scrivi i numeri. Vedi il totale, il costo del credito e cosa succede alla fine con la maxi rata.</p>
    </div>
    <DecodeForm client:load siteKey={siteKey} />
  </section>

  <!-- L'officina è una porta d'ingresso, non ancora attiva: una riga sotto la piega (specifica v2, §1). -->
  <section class="contenitore pt-14" aria-label="Officina">
    <p class="grid gap-1 border-t border-riga pt-5 sm:flex sm:flex-wrap sm:items-baseline sm:gap-x-2">
      <span>Hai in mano un preventivo o una fattura dell’officina? A dicembre leggiamo anche quelli.</span>
      <a class="link tocco font-semibold" href="/officina">Lasciacelo e ti avvisiamo</a>
    </p>
  </section>

  <section class="contenitore sezione grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16" aria-labelledby="come-titolo">
    <div class="grid content-start gap-6">
      <h2 id="come-titolo" class="titolo-sezione">Come facciamo i conti</h2>
      <p class="nota max-w-[24em] text-tenue">I tuoi numeri restano sul tuo telefono, non li riceviamo. Le formule, una per una, sono nella <a class="link" href="/metodologia">metodologia</a>.</p>
    </div>
    <ol class="grid content-start gap-10 lg:pt-2">
      <li class="si-accende grid grid-cols-[3.5rem_1fr] gap-4 border-t border-inchiostro pt-5 sm:grid-cols-[5rem_1fr]">
        <span class="numero-scena text-segnale-scuro">01</span>
        <div class="grid gap-2"><h3 class="titolo-scheda">Sommiamo tutto quello che esce dal tuo conto</h3><p class="max-w-[28em] text-tenue">Anticipo, rate, maxi rata, spese. Il totale è il numero che il cartello con la rata non dice.</p></div>
      </li>
      <li class="si-accende grid grid-cols-[3.5rem_1fr] gap-4 border-t border-inchiostro pt-5 sm:grid-cols-[5rem_1fr]">
        <span class="numero-scena text-segnale-scuro">02</span>
        <div class="grid gap-2"><h3 class="titolo-scheda">Lo confrontiamo con il prezzo</h3><p class="max-w-[28em] text-tenue">La differenza è il costo del credito. Ricostruiamo anche il tasso annuo (TAEG) dai numeri visibili e ti diciamo se torna.</p></div>
      </li>
      <li class="si-accende grid grid-cols-[3.5rem_1fr] gap-4 border-t border-inchiostro pt-5 sm:grid-cols-[5rem_1fr]">
        <span class="numero-scena text-segnale-scuro">03</span>
        <div class="grid gap-2"><h3 class="titolo-scheda">Ti mostriamo la fine del contratto</h3><p class="max-w-[28em] text-tenue">Tenere l’auto pagando la maxi rata, restituirla o cambiarla, e il valore stimato dell’auto contro il debito, mese per mese.</p></div>
      </li>
    </ol>
  </section>
</Base>

<script>
  import { collegaPulsanteEsempio } from '~/lib/client/esempio';
  collegaPulsanteEsempio(document);
</script>
