---
import Base from '~/layouts/Base.astro';
import ModuloOfficina from '~/components/form/ModuloOfficina.astro';
import { contaAtteseOfficina } from '~/lib/db/officina';
import { TESTO_ATTESA, testoContatore } from '~/lib/officina';
import { chiaveAntiRobot } from '~/lib/turnstile';

export const prerender = false;
const env = Astro.locals.runtime?.env;
const siteKey = chiaveAntiRobot(env, Astro.url.href);
Astro.response.headers.set('cache-control', 'no-store');
const contatore = testoContatore(env?.DB ? await contaAtteseOfficina(env.DB) : null);
const [frase1, frase2] = TESTO_ATTESA.split('. ');
---
<Base
  title="Preventivo dell’officina: il confronto con il prezzo giusto arriva a dicembre | Rata Vera"
  description="Hai un preventivo o una fattura dell’officina? Lascia modello, intervento, importo e provincia: il confronto con il prezzo giusto arriva a dicembre 2026."
>
  <section class="contenitore grid gap-10 pt-8 pb-12 sm:pt-14 lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] lg:gap-16" aria-labelledby="officina-titolo">
    <div class="grid content-start gap-6">
      <p class="etichetta">Officina · in arrivo</p>
      <h1 id="officina-titolo" class="titolo-pagina max-w-[12ch]">Il preventivo dell’officina.</h1>
      <p class="frase-grande max-w-[22em]">{frase1}.</p>
      <p class="max-w-[28em] text-lg text-tenue">{frase2}</p>
      {contatore && <p class="numeri text-2xl" data-contatore-officina>{contatore}</p>}
      <dl class="grid gap-4 border-t border-riga pt-6 sm:grid-cols-2">
        <div class="grid gap-1">
          <dt class="etichetta">Cosa chiediamo</dt>
          <dd>Modello, intervento, importo e provincia. L’email solo se vuoi l’avviso.</dd>
        </div>
        <div class="grid gap-1">
          <dt class="etichetta">Cosa non facciamo</dt>
          <dd>Non diamo un giudizio sul tuo preventivo adesso: con pochi dati sarebbe un’opinione, non un numero.</dd>
        </div>
      </dl>
    </div>
    <ModuloOfficina siteKey={siteKey} />
  </section>
</Base>
