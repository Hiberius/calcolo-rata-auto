---
import Base from '~/layouts/Base.astro';
import { tutteLeGuide } from '~/lib/guide';
export const prerender = true;
const guide = tutteLeGuide();
---
<Base title="Guide su maxi rata, TAEG e noleggio a lungo termine | Rata Vera" description="Guide con i conti fatti su maxi rata finale, valore futuro garantito, TAEG del finanziamento auto e noleggio a lungo termine per privati.">
  <section class="contenitore pt-8 pb-12 sm:pt-14 grid gap-8">
    <h1 class="titolo-pagina max-w-[16ch]">Guide su maxi rata, TAEG e noleggio.</h1>
    <ol class="grid gap-0 max-w-3xl">
      {guide.map((g, i) => (
        <li class="riga-tratteggiata">
          {/* Tutta la riga è il link: area di tocco alta quanto la voce, non solo il titolo da 28 px. */}
          <a class="voce-guida grid grid-cols-[3rem_1fr] gap-4 py-5" href={`/guide/${g.slug}`}>
            <span class="numeri text-2xl text-tenue">{String(i + 1).padStart(2, '0')}</span>
            <span class="grid gap-1">
              <span class="voce-guida-titolo text-lg font-semibold">{g.titolo}</span>
              <span class="nota text-tenue max-w-[34em]">{g.descrizione}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
