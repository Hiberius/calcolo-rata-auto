---
import Base from '~/layouts/Base.astro';
import { tutteLeGuide } from '~/lib/guide';
export const prerender = true;
const guide = tutteLeGuide();
---
<Base title="Guide su maxi rata, TAEG e noleggio a lungo termine | Rata Vera" description="Guide con i conti fatti su maxi rata finale, valore futuro garantito, TAEG del finanziamento auto e noleggio a lungo termine per privati.">
  <section class="contenitore pt-8 pb-12 sm:pt-14 grid gap-8">
    <h1 class="font-semibold tracking-tight leading-[1.05] text-[length:var(--testo-titolo)] max-w-[20ch]">Guide, con i conti fatti.</h1>
    <ol class="grid gap-0 max-w-3xl">
      {guide.map((g, i) => (
        <li class="riga-tratteggiata grid grid-cols-[3rem_1fr] gap-4 py-5">
          <span class="numeri text-2xl text-segnale">{String(i + 1).padStart(2, '0')}</span>
          <span class="grid gap-1">
            <a class="link text-lg font-semibold" href={`/guide/${g.slug}`}>{g.titolo}</a>
            <span class="text-tenue text-sm">{g.descrizione}</span>
          </span>
        </li>
      ))}
    </ol>
  </section>
</Base>
