---
import Base from '~/layouts/Base.astro';
import BottonePagamento from '~/components/form/BottonePagamento.astro';
import Campo from '~/components/form/Campo.astro';
import EsitoModulo from '~/components/form/EsitoModulo.astro';
import TurnstileImplicito from '~/components/form/TurnstileImplicito.astro';
import { CONSENSI } from '~/lib/consent';
import { linkPagamento } from '~/lib/sito';
import { TURNSTILE_SITE_KEY_TEST } from '~/lib/turnstile';

export const prerender = false;
const env = Astro.locals.runtime?.env;
const siteKey = env?.PUBLIC_TURNSTILE_SITE_KEY || TURNSTILE_SITE_KEY_TEST;
const link149 = linkPagamento(env?.PUBLIC_STRIPE_LINK_B2B_149);
const link299 = linkPagamento(env?.PUBLIC_STRIPE_LINK_B2B_299);
const consenso = CONSENSI.contatto_b2b;
const CONTROLLI = [
  ['TAEG', 'indicato e in evidenza almeno quanto la rata'],
  ['Maxi rata finale', 'importo scritto accanto alla rata, non solo nella nota'],
  ['Prezzo in contanti e anticipo', 'presenti in ogni annuncio con la rata, come chiede il nuovo articolo 123 del Testo unico bancario'],
  ['Avvertenza sul costo del credito', 'la frase standard prevista per la pubblicità del credito ai consumatori'],
  ['Riquadro unico', 'rata, numero di rate, anticipo, maxi rata, TAN, TAEG, prezzo, validità nello stesso blocco'],
] as const;
---
<Base
  title="Annunci auto con la rata: controllo e adeguamento alle nuove regole | Rata Vera"
  description="Per le concessionarie: controlliamo gli annunci con la rata mensile (TAEG, maxi rata, prezzo in contanti, avvertenza) e riscriviamo i testi. Report da 149 €."
>
  <section class="contenitore pt-8 pb-10 sm:pt-14 grid gap-5">
    <p class="numeri text-sm text-tenue">Per le concessionarie</p>
    <h1 class="font-semibold tracking-tight leading-[1.05] text-[length:var(--testo-titolo)] max-w-[20ch]">Gli annunci con la rata, in regola prima del 20 novembre.</h1>
    <p class="text-lg max-w-prose text-tenue">
      Il decreto legislativo 212/2025 recepisce la nuova direttiva sul credito ai consumatori, applicabile dal 20 novembre 2026. Controlliamo i vostri annunci «da X € al mese» su sito e social e vi diamo i testi già corretti.
    </p>
  </section>

  <section class="contenitore grid gap-10 lg:grid-cols-2" aria-labelledby="cosa-titolo">
    <div class="grid content-start gap-4">
      <h2 id="cosa-titolo" class="text-2xl font-semibold tracking-tight">Cosa controlliamo</h2>
      <dl class="grid">
        {CONTROLLI.map(([k, v]) => (
          <div class="riga-tratteggiata grid gap-0.5 py-3"><dt class="font-semibold">{k}</dt><dd class="text-tenue">{v}</dd></div>
        ))}
      </dl>
    </div>
    <article class="scontrino rounded-t grid content-start gap-3 px-6 py-7" aria-label="Esempio di report anonimizzato">
      <p class="numeri text-xs text-tenue">ESEMPIO DI REPORT · ANONIMIZZATO</p>
      <p class="font-semibold">Annuncio social: «SUV ibrido da 219 € al mese»</p>
      <ul class="grid gap-2 text-sm">
        <li class="border-l-4 border-segnale pl-3">TAEG assente nell'immagine e nel testo</li>
        <li class="border-l-4 border-segnale pl-3">Maxi rata finale non indicata: compare solo «valore futuro garantito» nel link</li>
        <li class="border-l-4 border-attenzione pl-3">Prezzo in contanti assente; anticipo scritto in piccolo</li>
        <li class="border-l-4 border-ok pl-3">Durata e numero di rate presenti</li>
      </ul>
      <p class="text-sm"><span class="font-semibold">Testo proposto: </span>«219 € al mese per 35 mesi, anticipo 4.900 €, maxi rata finale 16.200 €. TAN 6,99%, TAEG 9,4%. Prezzo in contanti 27.900 €. Offerta valida fino al…», con l'avvertenza standard sotto.</p>
      <p class="text-xs text-tenue">Cifre di esempio. Il report vero ha lo screenshot di ogni annuncio con data e indirizzo.</p>
    </article>
  </section>

  <section class="contenitore sezione grid gap-6" aria-labelledby="offerte-titolo">
    <h2 id="offerte-titolo" class="text-2xl font-semibold tracking-tight">Due formule</h2>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="grid content-start gap-3 border-t-4 border-inchiostro bg-white/60 p-6">
        <p class="numeri text-4xl font-semibold">149 €</p>
        <h3 class="font-semibold">Report e adeguamento dei testi</h3>
        <p class="text-tenue">Controllo degli annunci attivi, report con screenshot, testi corretti pronti da pubblicare. Consegna in 3 giorni lavorativi.</p>
        <BottonePagamento href={link149} etichetta="Paga 149 €" evento="b2b_click" />
      </div>
      <div class="grid content-start gap-3 border-t-4 border-segnale bg-white/60 p-6">
        <p class="numeri text-4xl font-semibold">299 €</p>
        <h3 class="font-semibold">Report, testi e 10 schede promo pronte</h3>
        <p class="text-tenue">Tutto il precedente più 10 schede promozione nel riquadro unico, con totale e costo del credito calcolati, pronte per sito e social.</p>
        <BottonePagamento href={link299} etichetta="Paga 299 €" evento="b2b_click" />
      </div>
    </div>
    <p class="text-sm text-tenue max-w-prose">Prezzi IVA esclusa. Il report è un controllo di conformità dei testi pubblicitari, non una consulenza legale.</p>
  </section>

  <section class="contenitore grid gap-6 pb-8 lg:grid-cols-[1fr_1.4fr]" aria-labelledby="contatto-titolo">
    <div class="grid content-start gap-3">
      <h2 id="contatto-titolo" class="text-2xl font-semibold tracking-tight">Scriveteci</h2>
      <p class="text-tenue max-w-prose">Indicate il sito o la pagina social: rispondiamo con un primo controllo gratuito di un annuncio.</p>
    </div>
    <form id="modulo" method="post" action="/api/b2b" class="grid gap-4 scroll-mt-6">
      <EsitoModulo successo="Richiesta ricevuta. Vi rispondiamo entro un giorno lavorativo." />
      <div class="grid gap-4 sm:grid-cols-2">
        <Campo nome="nome" etichetta="Nome" obbligatorio attributi={{ autocomplete: 'name', maxlength: 80 }} />
        <Campo nome="azienda" etichetta="Concessionaria" obbligatorio attributi={{ autocomplete: 'organization', maxlength: 120 }} />
        <Campo nome="email" etichetta="Email" tipo="email" obbligatorio attributi={{ autocomplete: 'email', maxlength: 120 }} />
        <Campo nome="sito" etichetta="Sito o pagina social" tipo="url" attributi={{ maxlength: 200, placeholder: 'https://' }} />
      </div>
      <label class="grid gap-1 text-sm"><span class="font-medium">Messaggio <span class="text-tenue font-normal">(facoltativo)</span></span>
        <textarea class="campo font-sans min-h-28" name="messaggio" maxlength="1000"></textarea>
      </label>
      <label class="flex items-start gap-3 text-sm cursor-pointer">
        <input type="checkbox" name="consensoContatto" required class="mt-1 size-5 accent-[#15171A]" />
        <span>{consenso.testo}</span>
      </label>
      <input type="hidden" name="versioneConsenso" value={consenso.versione} />
      <TurnstileImplicito siteKey={siteKey} />
      <div><button type="submit" class="btn btn-primario w-full sm:w-auto">Invia la richiesta</button></div>
    </form>
  </section>
</Base>
