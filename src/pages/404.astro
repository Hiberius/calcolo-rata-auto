---
import Base from '~/layouts/Base.astro';
export const prerender = true;
---
<Base title="Pagina non trovata | Rata Vera" description="Questa pagina non esiste." noindex>
  <section class="contenitore sezione grid gap-5 max-w-2xl">
    <p class="numeri text-6xl font-semibold text-segnale">404</p>
    <h1 class="text-3xl font-semibold tracking-tight">Questa pagina non c'è.</h1>
    <p class="text-tenue">Il link potrebbe essere incompleto o la pagina è stata spostata. I conti però si fanno sempre dalla pagina iniziale.</p>
    <p class="flex flex-wrap gap-3"><a class="btn btn-primario" href="/#decodifica">Leggi un preventivo</a><a class="btn btn-secondario" href="/promozioni">Promozioni</a></p>
  </section>
</Base>
