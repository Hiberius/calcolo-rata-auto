---
import Base from '~/layouts/Base.astro';
import TreStrade from '~/components/compare/TreStrade';
import ModuloNoleggio from '~/components/form/ModuloNoleggio.astro';
import { TURNSTILE_SITE_KEY_TEST } from '~/lib/turnstile';

export const prerender = false;
const siteKey = Astro.locals.runtime?.env?.PUBLIC_TURNSTILE_SITE_KEY || TURNSTILE_SITE_KEY_TEST;
---
<Base
  title="Stessa auto, tre strade: contanti, maxi rata o noleggio a lungo termine | Rata Vera"
  description="Confronta la stessa auto pagata in contanti o con un prestito, con il preventivo a maxi rata o a noleggio a lungo termine. Ipotesi visibili e modificabili."
>
  <section class="contenitore pt-8 pb-10 sm:pt-14 grid gap-5">
    <h1 class="titolo-pagina max-w-[16ch]">Stessa auto, tre strade.</h1>
    <p class="text-lg max-w-prose text-tenue">
      Contanti o prestito personale, il preventivo con la maxi rata, il noleggio a lungo termine. Per ognuna: quanto esce dal tuo conto e cosa ti resta alla fine. Le ipotesi sono scritte accanto ai numeri e le puoi cambiare.
    </p>
  </section>

  <section class="contenitore" aria-label="Confronto tre strade">
    <TreStrade client:load />
  </section>

  <section class="contenitore sezione grid gap-8 lg:grid-cols-[1fr_1.4fr]" aria-labelledby="richiesta-titolo">
    <div class="grid content-start gap-4">
      <h2 id="richiesta-titolo" class="text-2xl font-semibold tracking-tight">Vuoi un preventivo di noleggio vero?</h2>
      <p class="max-w-prose">Indica modello, durata e chilometri: Rata Vera cerca le offerte di noleggio a lungo termine e ti scrive. Il noleggio non è un finanziamento: a fine contratto riconsegni l'auto.</p>
      <p class="text-sm text-tenue max-w-prose">Se ti proponiamo un noleggiatore te lo nominiamo e ti chiediamo un nuovo consenso prima di passargli i tuoi dati. Il compenso, se firmi, non lo paghi tu e non cambia i conti mostrati qui sopra.</p>
    </div>
    <ModuloNoleggio siteKey={siteKey} />
  </section>
</Base>
