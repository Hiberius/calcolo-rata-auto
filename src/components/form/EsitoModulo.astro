---
import { messaggioErrore } from '~/lib/moduli';

interface Props {
  successo: string;
  /** Nomi leggibili dei campi da controllare (nome del campo → etichetta). Senza, si mostra il nome del campo. */
  etichette?: Readonly<Record<string, string>>;
}
const { successo, etichette = {} } = Astro.props;
const inviato = Astro.url.searchParams.get('inviato') === '1';
const errore = messaggioErrore(Astro.url.searchParams.get('errore'));
const campi = (Astro.url.searchParams.get('campi') ?? '').split(',').filter((c) => /^[a-zA-Z]{2,30}$/.test(c));
---
{inviato && <p class="border-l-4 border-ok bg-[#EEF6F0] px-4 py-3" role="status" data-esito-ok>{successo}</p>}
{errore && (
  <p class="border-l-4 border-segnale bg-[#FDEEE9] px-4 py-3" role="alert" data-esito-errore>
    {errore}{campi.length > 0 && <span class="block text-sm text-tenue">Campi da controllare: {campi.map((c) => etichette[c] ?? c).join(', ')}</span>}
  </p>
)}
