---
import { costoCreditoPct, euro, punti } from '~/lib/formato';
import { dataBreve } from '~/lib/date';
import type { PromoDecodificata } from '~/lib/promo';
import ComposizioneTotale from '~/components/ui/ComposizioneTotale';
import SpiegazioneTaeg from '~/components/ui/SpiegazioneTaeg';
import Termine from '~/components/ui/Termine';
import type { VoceGlossario } from '~/lib/glossario';

interface Props {
  decodificata: PromoDecodificata;
  link?: boolean;
  /** false dove la composizione del totale è già accanto (pagina della promo, con il risultato completo). */
  composizione?: boolean;
}
const { decodificata: d, link = false, composizione = true } = Astro.props;
const p = d.promo;
const t = d.analisi.totali;
const titolo = [p.marca, p.modello, p.versione].filter(Boolean).join(' ');
const href = `/promozioni/${d.slugMarca}/${d.slug}`;
const ambito = `promo-${p.id}`;
const righe: readonly (readonly [string, string, VoceGlossario?])[] = [
  ['Rata', euro(p.rata)],
  ['Numero di rate', String(p.nRate)],
  ['Anticipo', euro(p.anticipo)],
  ['Maxi rata finale', p.maxiRata ? euro(p.maxiRata) : 'nessuna', 'maxi'],
  ['TAN', punti(p.tan), 'tan'],
  ['TAEG', punti(p.taeg), 'taeg'],
  ['Prezzo in contanti', p.prezzoContanti != null ? euro(p.prezzoContanti) : 'non indicato'],
  ['Prezzo promozionale', p.prezzoPromo != null ? euro(p.prezzoPromo) : 'non indicato'],
  ['Validità', `${p.validoDal ? `dal ${dataBreve(p.validoDal)} ` : ''}fino al ${dataBreve(p.validoAl)}`],
];
---
<article
  class="scontrino grid gap-4 px-5 py-6"
  data-stampa={link ? '' : undefined}
  data-promo
  data-marca={p.marca}
  data-anticipo={p.anticipo}
  data-rata={p.rata}
  data-maxi={p.maxiRata ? '1' : '0'}
  data-valido-al={p.validoAl}
  aria-label={`Promozione ${titolo}`}
>
  <header class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="text-lg font-semibold tracking-tight">
      {link ? <a class="link tocco" href={href}>{titolo}</a> : titolo}
    </h3>
    <p class="numeri text-xs text-tenue">{p.tipo}</p>
  </header>
  {d.scaduta && (
    <p class="text-sm bg-[#FDEEE9] border-t-2 border-segnale px-3 py-2" data-avviso-scaduta>
      Promozione scaduta il {dataBreve(p.validoAl)}: i numeri restano per confronto.
    </p>
  )}
  <dl class="grid grid-cols-2 gap-x-6 sm:grid-cols-3">
    {righe.map(([k, v, voce]) => (
      <div class="riga-tratteggiata flex flex-col py-1.5">
        <dt class="text-[0.8125rem] leading-snug text-tenue">{voce ? <Termine voce={voce} ambito={ambito}>{k}</Termine> : k}</dt>
        <dd class="numeri">{v}</dd>
      </div>
    ))}
  </dl>
  <div class="grid gap-2">
    <p class="grid gap-0.5">
      <span class="text-sm">Paghi in tutto, tenendo l’auto</span>
      <span class="numeri text-2xl font-semibold">{euro(t.totalePagatoTenendo)}</span>
      {t.costoCredito != null && (
        <span class="numeri text-segnale-scuro font-semibold">Costo del credito {euro(t.costoCredito)} · {costoCreditoPct(t.costoCreditoPct)} del prezzo</span>
      )}
    </p>
    {t.costoCredito != null && <SpiegazioneTaeg classe="nota text-tenue" />}
    {composizione && <p class="text-sm font-medium pt-1">Da dove viene il totale</p>}
    {composizione && <ComposizioneTotale analisi={d.analisi} compatta />}
  </div>
  {p.requisiti.length > 0 && <p class="text-sm"><span class="font-medium">Condizioni: </span>{p.requisiti.join(', ')}</p>}
  <p class="text-[0.8125rem] leading-snug text-tenue">
    Fonte: <a class="link" href={p.urlFonte} rel="nofollow noopener" target="_blank">{new URL(p.urlFonte).hostname}</a>, verificata il {dataBreve(p.dataVerifica)}.
    Cifre riscritte da Rata Vera: fa fede il documento della casa.
  </p>
</article>
