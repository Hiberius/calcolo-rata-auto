---
interface Props { id: string }
const { id } = Astro.props;
---
<!-- Visibile solo a chi ha creato la scheda (codice in sessionStorage) o a chi apre il link di cancellazione.
     Il blocco sta in un template: chi guarda la scheda da un link condiviso non lo vede, nemmeno senza stile. -->
<div data-elimina data-id={id}></div>
<template data-elimina-modello>
  <section class="grid gap-3 border-t-4 border-segnale pt-5" aria-labelledby="elimina-titolo">
    <h2 id="elimina-titolo" class="font-semibold text-lg">Questa scheda l'hai creata tu</h2>
    <p class="text-sm max-w-prose">Puoi eliminarla quando vuoi: spariscono la pagina, l'immagine e, se avevi dato il consenso, il preventivo dall'archivio.</p>
    <label class="grid gap-1 text-sm">
      <span class="font-medium">Link per eliminarla più tardi, anche da un altro dispositivo</span>
      <input class="campo text-xs" readonly data-link-elimina />
    </label>
    <p class="text-xs text-tenue max-w-prose">Tienilo per te: chi ha questo link può eliminare la scheda. Per condividere usa il link qui sopra, senza codice.</p>
    <div class="flex flex-wrap gap-3">
      <button type="button" class="btn btn-secondario" data-copia-link-elimina>Copia il link per eliminarla</button>
      <button type="button" class="btn btn-secondario !border-segnale-scuro text-segnale-scuro" data-elimina-scheda>Elimina questa scheda</button>
      <button type="button" class="btn btn-secondario" data-annulla-elimina hidden>Annulla</button>
    </div>
    <p class="text-sm min-h-5" role="status" data-esito-elimina></p>
  </section>
</template>

<script>
  import { avviaEliminaScheda } from '~/lib/client/eliminaScheda';
  avviaEliminaScheda(document, location, history);
</script>
