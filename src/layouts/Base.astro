---
import '~/styles/global.css';
import { AVVERTENZA } from '~/lib/calc';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, ogImage, canonical, noindex = false } = Astro.props;
const sito = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ratavera.it';
const url = canonical ?? `${sito}${Astro.url.pathname}`;
const immagine = ogImage ?? `${sito}/og-default.png`;
const tokenAnalytics = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const NAV = [['/#decodifica', 'Leggi il preventivo'], ['/promozioni', 'Promozioni'], ['/noleggio', 'Confronta'], ['/guide', 'Guide']] as const;
const PIEDE = [
  ['/metodologia', 'Metodologia'], ['/criteri', 'Criteri delle promozioni'], ['/chi-siamo', 'Chi siamo'], ['/privacy', 'Privacy'],
  ['/cookie', 'Cookie'],
] as const;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={immagine} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F6F3EE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Font serviti da noi (OFL): nessuna richiesta a server di terzi prima di qualsiasi scelta del visitatore. -->
    <link rel="preload" href="/fonts/instrument-sans-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#contenuto" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 btn btn-primario">Vai al contenuto</a>
    <header class="contenitore flex items-center justify-between gap-4 py-5">
      <a href="/" class="group flex items-baseline gap-2 no-underline" aria-label="Rata Vera, pagina iniziale">
        <span class="font-semibold tracking-tight text-lg">Rata Vera</span>
        <span class="numeri text-xs text-tenue hidden sm:inline transition-colors group-hover:text-segnale">quanto paghi davvero</span>
      </a>
      <nav aria-label="Navigazione principale" class="flex flex-wrap justify-end gap-x-4 text-sm">
        {NAV.map(([href, testo]) => <a class="link tocco" href={href}>{testo}</a>)}
      </nav>
    </header>
    <main id="contenuto" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-riga mt-16">
      <div class="contenitore py-8 text-sm text-tenue grid gap-3 md:grid-cols-[2fr_1fr]">
        <p class="max-w-prose">{AVVERTENZA}</p>
        <p class="md:text-right">Nessun nome di banca o finanziaria, solo aritmetica. Le immagini dei preventivi non vengono mai salvate.</p>
        <p class="md:col-span-2" data-riga-cookie-piede>Solo cookie tecnici, nessuna profilazione. <a class="link" href="/cookie">Dettagli sui cookie</a></p>
        <nav aria-label="Informazioni" class="md:col-span-2 flex flex-wrap gap-x-5">
          {PIEDE.map(([href, testo]) => <a class="link tocco" href={href}>{testo}</a>)}
        </nav>
      </div>
    </footer>
    <!-- Riga informativa in fondo alla pagina, aggiunta dallo script solo finché non la chiudi: dentro un template
         non compare a chi legge la pagina senza stile, dove avrebbe ripetuto la riga del piè di pagina. -->
    <template data-riga-cookie>
      <div class="fixed inset-x-0 bottom-0 z-50 border-t border-inchiostro bg-carta text-sm" data-banner-cookie role="region" aria-label="Informativa sui cookie">
        <div class="contenitore flex items-center justify-between gap-3">
          <p class="py-1.5">Solo cookie tecnici, nessuna profilazione. <a class="link" href="/cookie">Dettagli</a></p>
          <button type="button" class="tocco shrink-0 px-2 font-semibold underline decoration-1 underline-offset-4 hover:decoration-segnale" data-chiudi-banner>Chiudi</button>
        </div>
      </div>
    </template>
    {tokenAnalytics && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: tokenAnalytics })}></script>}
    <script>
      import { avviaPagina } from '~/lib/client/pagina';
      avviaPagina(document);
    </script>
  </body>
</html>
