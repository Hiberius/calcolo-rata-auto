---
import '~/styles/global.css';
import { AVVERTENZA } from '~/lib/calc';
import { REPO_GITHUB, URL_SITO } from '~/lib/sito';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  /** Testo alternativo dell'immagine di condivisione, se la pagina ne ha una sua. */
  ogAlt?: string;
  /** Pagine da leggere (guide, metodologia, testi): barra di lettura sotto la testata (interazione 11). */
  lettura?: boolean;
}
const { title, description, ogImage, canonical, noindex = false, ogAlt, lettura = false } = Astro.props;
const sito = (Astro.site?.toString() ?? URL_SITO).replace(/\/$/, '');
// Canonical senza .html (build.format 'file') e senza /index: lo stesso indirizzo della sitemap e del menu.
const percorso = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const url = canonical ?? `${sito}${percorso}`;
const immagine = ogImage ?? `${sito}/og-default.png`;
const immagineAlt = ogAlt ?? (ogImage ? title : 'Rata Vera: quanto paghi davvero per l’auto a rate? Accanto, uno scontrino bianco attraversato da una barra vermiglia.');
const tokenAnalytics = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const NAV = [
  ['/#decodifica', 'Leggi il preventivo'], ['/promozioni', 'Promozioni'], ['/indice', 'Indice'], ['/noleggio', 'Confronta'], ['/guide', 'Guide'], ['/metodologia', 'Metodologia'],
] as const;
/** Voce corrente del menu: la pagina stessa o una sua sottopagina (non per l'ancora della home). */
function corrente(href: string): boolean {
  const percorso = Astro.url.pathname.replace(/\.html$/, '');
  return percorso === href || (href !== '/#decodifica' && percorso.startsWith(`${href}/`));
}
const PIEDE = [
  ['/metodologia', 'Metodologia'], ['/criteri', 'Criteri delle promozioni'], ['/chi-siamo', 'Chi siamo'], ['/privacy', 'Privacy'],
  ['/cookie', 'Cookie'], ['/officina', 'Officina'], ['/indice/metodologia', 'Metodologia dell’Indice'], [REPO_GITHUB, 'Codice sorgente'],
] as const;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={immagine} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={immagineAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={immagine} />
    <meta name="twitter:image:alt" content={immagineAlt} />
    <meta name="theme-color" content="#F6F3EE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icone/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icone/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/icone/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- La riga sui cookie già chiusa non deve comparire nemmeno per un fotogramma: si decide prima del disegno. -->
    <script is:inline>try{if(localStorage.getItem('ratavera:banner-cookie')==='1')document.documentElement.dataset.cookieLetto=''}catch(e){}</script>
    <!-- Font serviti da noi (OFL): nessuna richiesta a server di terzi prima di qualsiasi scelta del visitatore. -->
    <link rel="preload" href="/fonts/instrument-sans-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#contenuto" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 btn btn-primario">Vai al contenuto</a>
    {lettura && <div class="barra-lettura" aria-hidden="true"></div>}
    <!-- Riga informativa sui cookie: nel flusso, in cima, mai sopra i controlli della pagina; «Chiudi» la toglie per sempre. -->
    <div class="riga-cookie" data-banner-cookie role="region" aria-label="Informativa sui cookie">
      <div class="contenitore flex items-center justify-between gap-3 text-[0.8125rem] leading-tight">
        <p class="flex items-center gap-x-2"><span>Solo cookie tecnici<span class="hidden sm:inline">, nessuna profilazione</span>.</span> <a class="link tocco" href="/cookie">Dettagli</a></p>
        <button type="button" class="tocco shrink-0 justify-center px-2 font-semibold underline decoration-1 underline-offset-4 hover:decoration-segnale" data-chiudi-banner>Chiudi</button>
      </div>
    </div>
    <!-- Testata: una riga sola (≤ 64 px). Sotto i 1024 px il menu sta in un pannello che si apre con «Menu» (details, senza JS). -->
    <header class="testata contenitore relative flex items-center justify-between gap-x-8 py-2 sm:py-3">
      <a href="/" class="tocco group no-underline" aria-label="Rata Vera, quanto paghi davvero">
        <span class="flex items-baseline gap-2">
          <span class="font-semibold tracking-tight text-lg">Rata Vera</span>
          <span class="numeri text-xs text-tenue hidden sm:inline transition-colors group-hover:text-segnale">quanto paghi davvero</span>
        </span>
      </a>
      <nav aria-label="Navigazione principale" class="hidden lg:flex lg:items-center lg:gap-x-1 text-sm">
        {NAV.map(([href, testo]) => <a class="voce-menu" href={href} aria-current={corrente(href) ? 'page' : undefined}>{testo}</a>)}
      </nav>
      <details class="menu-compatto lg:hidden" data-menu>
        <summary class="voce-menu menu-apri font-semibold" aria-label="Menu di navigazione"><span aria-hidden="true" class="menu-segno"></span>Menu</summary>
        <nav aria-label="Navigazione principale" class="menu-pannello">
          {NAV.map(([href, testo]) => <a class="voce-menu" href={href} aria-current={corrente(href) ? 'page' : undefined}>{testo}</a>)}
        </nav>
      </details>
    </header>
    <main id="contenuto" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-riga mt-16">
      <div class="contenitore py-8 text-sm text-tenue grid gap-3 md:grid-cols-[2fr_1fr]">
        <p class="max-w-prose">{AVVERTENZA}</p>
        <p class="md:text-right">Nessun nome di banca o finanziaria, solo aritmetica. Le immagini dei preventivi non vengono mai salvate.</p>
        <p class="md:col-span-2 flex flex-wrap items-center gap-x-2" data-riga-cookie-piede>Solo cookie tecnici, nessuna profilazione. <a class="link tocco" href="/cookie">Dettagli sui cookie</a></p>
        <nav aria-label="Informazioni" class="md:col-span-2 flex flex-wrap gap-x-5">
          {PIEDE.map(([href, testo]) => <a class="link tocco" href={href}>{testo}</a>)}
        </nav>
      </div>
    </footer>
    {tokenAnalytics && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: tokenAnalytics })}></script>}
    <script>
      import { avviaPagina } from '~/lib/client/pagina';
      avviaPagina(document);
    </script>
  </body>
</html>
