{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratavera",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Il Worker passa anche sulle pagine statiche per aggiungere CSP con nonce e intestazioni di sicurezza (src/worker.ts).
  "assets": { "binding": "ASSETS", "directory": "./dist", "run_worker_first": ["/*", "!/_astro/*", "!/fonts/*", "!/favicon.svg", "!/og-default.png"] },
  // Pulizia notturna secondo i tempi di conservazione di /privacy (src/lib/db/pulizia.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ratavera-db",
      "database_id": "fe67497f-635f-41ad-b006-d1168b159f34",
      "migrations_dir": "src/lib/db/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "d2347e80ecb846d4af2491ddec46b477" }
  ],
  "ai": { "binding": "AI", "remote": true },
  // Variabili pubbliche. La chiave Turnstile qui sotto e' quella di TEST di Cloudflare (passa sempre):
  // sostituirla con la chiave vera quando il sito e' sul dominio. I segreti vanno con `wrangler secret put`.
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "PUBLIC_SITE_URL": "https://ratavera.it",
    "ESTRAZIONE_LIMITE_GIORNO": "20",
    "ESTRAZIONE_LIMITE_MINUTO": "3",
    "EMAIL_MITTENTE": "notifiche@ratavera.it",
    // Link di pagamento Stripe: vuoti = "Pagamento disponibile a breve" sulle pagine.
    "PUBLIC_STRIPE_LINK_VERDETTO": "",
    "PUBLIC_STRIPE_LINK_B2B_149": "",
    "PUBLIC_STRIPE_LINK_B2B_299": ""
  }
}
