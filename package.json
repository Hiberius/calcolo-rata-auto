{
  "name": "ratavera",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ratavera-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ratavera-db --remote",
    "cf-typegen": "wrangler types",
    "promo:raccogli": "vite-node --config vitest.config.ts scripts/promo/raccogli.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/preact": "^4.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "heic2any": "^0.0.4",
    "pdfjs-dist": "^6.4.299",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "workers-og": "^0.0.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.63",
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  }
}
